[Unit]
Description=Reranker BGE-v2-m3 GPU :8088 (bibliotecario persistente)
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
WorkingDirectory=/home/israel/Documentos/alcon/server
ExecStart=/home/israel/Documentos/alcon/.venv/bin/python /home/israel/Documentos/montar-modelos/rag-servers/rag-rerank-gpu.py
Restart=no
Environment=RERANK_MODEL=BAAI/bge-reranker-v2-m3
Environment=RERANK_PORT=8088
[Install]
WantedBy=default.target
